# --- Which AI to use: gemini | anthropic | openai | ollama | mock
LLM_PROVIDER=gemini
# Optional second provider used automatically if the first one fails
FALLBACK_PROVIDER=

# Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (local, free: https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# Try the UI with no key at all: set MOCK_LLM=1
MOCK_LLM=0

# --- App
APP_ENV=dev
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./doubtchat.db
# Postgres example: postgresql+psycopg://doubtchat:doubtchat@localhost:5432/doubtchat
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO
